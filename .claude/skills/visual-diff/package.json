{
  "name": "visual-diff",
  "version": "0.2.0",
  "private": true,
  "description": "Screenshots antes/depois, diff de pixels e resumo de UX para PRs que mudam UI (skill de agente + CLI).",
  "type": "module",
  "bin": {
    "visual-diff": "bin/visual-diff.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "setup": "npm install && playwright install chromium",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "schema": "node scripts/write-schema.mjs"
  },
  "dependencies": {
    "axe-core": "^4.14.1",
    "gifenc": "^1.0.3",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "references",
    "SKILL.md",
    "visual-diff.schema.json",
    "package.json",
    "package-lock.json"
  ]
}
